# ---------------------------------------------------------------------------
# Copiez ce fichier en .env.local (développement) et renseignez les mêmes
# variables dans Vercel > Settings > Environment Variables (production).
# Ne commitez JAMAIS de vraies valeurs.
# ---------------------------------------------------------------------------

# URL publique du site (sans slash final). Sert à construire les liens personnels de modification des réponses.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro WhatsApp des mariés (facultatif), au format international, ex. : +4512345678.
# Affiche un bouton "Nous écrire sur WhatsApp" sous le formulaire et sur l'écran de remerciement.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé "service_role" : SERVEUR UNIQUEMENT. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Liens sécurisés de modification des réponses ---
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 48).
RSVP_TOKEN_SECRET=
# Sel utilisé pour anonymiser les adresses IP dans la limitation de débit.
RATE_LIMIT_SALT=

# --- E-mails (Resend) - facultatif ---
# Confirmation et lien de modification envoyés à l'invité, notification aux organisateurs.
# Sans Resend, le lien de modification reste affiché à l'écran après l'envoi du formulaire.
RESEND_API_KEY=
# Adresse expéditrice sur un domaine vérifié chez Resend, ex. : Marleine & Franck <mariage@votre-domaine.tld>
EMAIL_FROM=
# Adresse(s) des organisateurs notifiée(s) à chaque réponse (séparées par des virgules).
ADMIN_NOTIFICATION_EMAIL=

# --- Protection anti-robots (Cloudflare Turnstile, gratuit) - recommandé ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Conservation des données ---
# Nombre de jours conservés après le mariage (30/11/2026) avant suppression automatique.
DATA_RETENTION_DAYS=90
# Secret de la tâche planifiée /api/cron/purge (Vercel l'envoie en "Authorization: Bearer ...").
CRON_SECRET=
